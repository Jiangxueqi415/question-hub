.stats-loading {
  padding: 80rpx 40rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

.stats-head {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(31, 58, 110, 0.06);
}

.stats-head__title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #111827;
}

.stats-head__meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #8a94a6;
}

.stats-head__desc {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4b5563;
}

.stats-head__actions {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.stats-head__actions .btn + .btn {
  margin-left: 16rpx;
}

.stats-tabs {
  display: flex;
  margin-bottom: 20rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 58, 110, 0.05);
}

.stats-tab {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a94a6;
}

.stats-tab--active {
  background: #2f6fed;
  color: #ffffff;
  font-weight: 600;
}

.stats-question {
  padding: 26rpx;
}

.stats-question__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.stats-question__title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #111827;
}

.stats-question__type {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  background: #eef2f9;
  font-size: 20rpx;
  color: #6b7280;
}

.bars {
  margin-top: 22rpx;
}

.bar-row {
  margin-bottom: 20rpx;
}

.bar-row:last-child {
  margin-bottom: 0;
}

.bar-row__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.bar-row__label {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #374151;
}

.bar-row__value {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.bar-track {
  height: 18rpx;
  border-radius: 999rpx;
  background: #eef2f9;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  min-width: 4rpx;
  border-radius: 999rpx;
}

.pie-wrap {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.pie {
  flex-shrink: 0;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #eef2f9;
  box-shadow: inset 0 0 0 1rpx rgba(17, 24, 39, 0.04);
}

.pie-legend {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.pie-legend__row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.pie-legend__row:last-child {
  margin-bottom: 0;
}

.pie-legend__dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.pie-legend__text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #4b5563;
}

.pie-legend__value {
  flex-shrink: 0;
  margin-left: 10rpx;
  font-size: 21rpx;
  color: #8a94a6;
}

.stats-question__foot {
  margin-top: 16rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #9ca3af;
}

.stats-open {
  margin-top: 18rpx;
}

.stats-open__meta {
  font-size: 23rpx;
  color: #8a94a6;
}

.stats-open__item {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 24rpx;
  line-height: 1.6;
  color: #374151;
}

.stats-empty {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  text-align: center;
  font-size: 23rpx;
  color: #9ca3af;
}
