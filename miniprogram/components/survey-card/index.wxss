.survey-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(31, 58, 110, 0.06);
}

.survey-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.survey-card__title {
  flex: 1;
  margin-right: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  color: #111827;
}

.tag {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf1ff;
  color: #2f6fed;
  font-size: 20rpx;
}

.survey-card__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.survey-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.survey-card__deadline {
  font-size: 22rpx;
  color: #9ca3af;
}

.survey-card__reward {
  font-size: 24rpx;
  font-weight: 600;
  color: #2f6fed;
}
