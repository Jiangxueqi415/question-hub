.score-cards {
  display: flex;
  align-items: stretch;
}

.score-card {
  flex: 1;
  min-width: 0;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(31, 58, 110, 0.06);
}

.score-card + .score-card {
  margin-left: 20rpx;
}

.score-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.score-card__label {
  font-size: 24rpx;
  color: #6b7280;
}

.score-card__value {
  margin-top: 10rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.15;
  color: #2f6fed;
}

.score-card__unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #9ca3af;
}

.score-card__hint {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #9ca3af;
}

.level {
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.5;
}

.level--excellent {
  background: #e9f9ef;
  color: #15803d;
}

.level--good {
  background: #eaf1ff;
  color: #2f6fed;
}

.level--fair {
  background: #fff4e5;
  color: #c2410c;
}

.level--poor {
  background: #f1f3f7;
  color: #6b7280;
}

.progress {
  margin-top: 12rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #eef2f9;
  overflow: hidden;
}

.progress__bar {
  height: 100%;
  border-radius: 999rpx;
}

.progress__bar--excellent {
  background: #16a34a;
}

.progress__bar--good {
  background: #2f6fed;
}

.progress__bar--fair {
  background: #d97706;
}

.progress__bar--poor {
  background: #dc2626;
}
