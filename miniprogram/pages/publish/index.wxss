.publish-page {
  padding-bottom: 60rpx;
}

.publish-top {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(31, 58, 110, 0.06);
}

.publish-top__scores {
  display: flex;
  align-items: center;
}

.publish-top__score {
  flex: 1;
  text-align: center;
}

.publish-top__label {
  display: block;
  font-size: 23rpx;
  color: #8a94a6;
}

.publish-top__value {
  display: block;
  margin-top: 4rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #2f6fed;
}

.publish-top__divider {
  width: 1rpx;
  height: 56rpx;
  background: #eef1f7;
}

.publish-top__hint {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

.publish-top__hint--ok {
  background: #e9f9ef;
  color: #15803d;
}

.publish-top__hint--warn {
  background: #fff4e5;
  color: #c2410c;
}

.publish-section-title {
  margin-bottom: 26rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.time-row {
  display: flex;
}

.time-row picker {
  flex: 1;
}

.time-row picker + picker {
  margin-left: 16rpx;
}

.picker--time {
  flex: 0 0 180rpx;
}

.publish-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #9ca3af;
}

.publish-question {
  padding: 24rpx;
}

.publish-question__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.publish-question__no {
  font-size: 26rpx;
  font-weight: 600;
  color: #2f6fed;
}

.publish-question__ops {
  display: flex;
  align-items: center;
}

.publish-question__remove {
  margin-left: 20rpx;
}

.publish-question__title {
  background: #f8fafc;
}

.options-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 24rpx 4rpx 14rpx;
}

.options-head__label {
  font-size: 24rpx;
  color: #6b7280;
}

.options-head__hint {
  font-size: 21rpx;
  color: #9ca3af;
}

.option-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.option-row__letter {
  flex-shrink: 0;
  width: 42rpx;
  font-size: 23rpx;
  color: #9ca3af;
}

.option-row__input {
  flex: 1;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f6f8fc;
  font-size: 26rpx;
  color: #1f2937;
}

.option-row__remove {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  background: #fef2f2;
  text-align: center;
  line-height: 52rpx;
  font-size: 30rpx;
  color: #dc2626;
}

.publish-question__add {
  display: inline-block;
  margin-top: 8rpx;
}

.publish-open-hint {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 23rpx;
  color: #8a94a6;
}

.publish-add-question {
  margin-top: 4rpx;
  margin-bottom: 20rpx;
}

.publish-actions {
  margin-top: 12rpx;
}

.publish-actions__note {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
  color: #9ca3af;
}

.publish-guard {
  margin-bottom: 20rpx;
}

.publish-guard__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.publish-guard__desc {
  margin: 10rpx 0 28rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #8a94a6;
}

.edit-banner {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  border: 1rpx solid #dbe6ff;
  background: #f7faff;
}

.edit-banner__main {
  flex: 1;
  min-width: 0;
}

.edit-banner__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f6fed;
}

.edit-banner__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8a94a6;
}

.edit-banner__cancel {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #dc2626;
}

.template-card {
  padding: 26rpx;
}

.template-list {
  display: flex;
  overflow-x: auto;
  padding-bottom: 6rpx;
}

.template-item {
  flex: 0 0 300rpx;
  margin-right: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #eef2f9;
  background: #f8fafc;
}

.template-item:last-child {
  margin-right: 0;
}

.template-item__name {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eaf1ff;
  color: #2f6fed;
  font-size: 20rpx;
}

.template-item__title {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #374151;
}

.publish-desc {
  width: 100%;
  min-height: 150rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: #f6f8fc;
  font-size: 26rpx;
  line-height: 1.6;
  color: #1f2937;
}

.publish-lock-note {
  margin: -4rpx 4rpx 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff4e5;
  font-size: 23rpx;
  line-height: 1.55;
  color: #c2410c;
}

.publish-question__type {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #eef2f9;
  font-size: 22rpx;
  color: #6b7280;
}

.publish-question input[disabled] {
  color: #6b7280;
}
