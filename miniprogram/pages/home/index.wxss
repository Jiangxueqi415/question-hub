.home-page {
  padding-top: 20rpx;
}

.home-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 30rpx 30rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #2f6fed, #5b8cf7);
  box-shadow: 0 14rpx 34rpx rgba(47, 111, 237, 0.22);
}

.home-hero__main {
  flex: 1;
  min-width: 0;
}

.home-hero__hello {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.home-hero__sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.home-hero__points {
  flex-shrink: 0;
  margin-left: 20rpx;
  text-align: right;
  color: #ffffff;
}

.home-hero__points-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.home-hero__points-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  opacity: 0.8;
}

.home-loading {
  padding: 48rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

.own-card {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 58, 110, 0.05);
}

.own-card__main {
  flex: 1;
  min-width: 0;
}

.own-card__title {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.own-card__meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8a94a6;
}

.own-card__action {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #2f6fed;
}

.home-summary {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #eef4ff;
  text-align: center;
  font-size: 24rpx;
  color: #2f6fed;
}

.bind-tip {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dbe6ff;
  box-shadow: 0 8rpx 24rpx rgba(31, 58, 110, 0.05);
}

.bind-tip__main {
  flex: 1;
  min-width: 0;
}

.bind-tip__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.bind-tip__desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.bind-tip__action {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #2f6fed;
}

.home-notice {
  position: fixed;
  left: 50%;
  bottom: 140rpx;
  z-index: 20;
  transform: translateX(-50%);
  padding: 18rpx 36rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.92);
  color: #ffffff;
  font-size: 24rpx;
  white-space: nowrap;
}
