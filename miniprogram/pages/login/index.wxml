<view class="login-page">
  <view class="login-back" bindtap="onBack" hover-class="login-back--active">
    <text class="login-back__arrow">‹</text>
    <text>返回</text>
  </view>

  <view class="login-brand">
    <view class="login-brand__logo">互</view>
    <view class="login-brand__name">互答有据</view>
    <view class="login-brand__slogan">先帮助别人，再发布自己的问卷</view>
  </view>

  <view wx:if="{{checking}}" class="login-loading">正在恢复登录状态…</view>

  <view wx:elif="{{step === 'welcome'}}" class="login-card">
    <view class="login-feature">
      <text class="login-feature__icon">🎯</text>
      <view class="login-feature__body">
        <view class="login-feature__title">校内问卷互助</view>
        <view class="login-feature__desc">完成他人问卷赚积分，攒够 10 分即可发布自己的问卷</view>
      </view>
    </view>
    <view class="login-feature">
      <text class="login-feature__icon">⏱</text>
      <view class="login-feature__body">
        <view class="login-feature__title">服务端计时与判重</view>
        <view class="login-feature__desc">重复领取、发布者自填与异常作答都会被拦截</view>
      </view>
    </view>
    <view class="login-feature">
      <text class="login-feature__icon">📒</text>
      <view class="login-feature__body">
        <view class="login-feature__title">积分 / 信誉双账本</view>
        <view class="login-feature__desc">每次加分、扣分都有时间、原因与余额，可追溯</view>
      </view>
    </view>

    <button
      class="btn btn--primary btn--block login-submit"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="onLogin"
    >
      {{mockMode ? 'Mock 微信登录' : '微信一键登录'}}
    </button>

    <view wx:if="{{error}}" class="login-error">{{error}}</view>

    <view class="login-note">
      MVP 演示使用本地 Mock：不采集真实姓名、手机号与 IP；学号仅保存加盐哈希。
    </view>
  </view>

  <view wx:else class="login-card">
    <view class="login-card__title">绑定学号</view>
    <view class="login-card__desc">首次使用需要绑定学号，用于领取与发布资格校验。</view>

    <view class="field">
      <text class="field__label">学号</text>
      <input
        class="field__input"
        type="number"
        maxlength="12"
        placeholder="请输入 10–12 位数字"
        value="{{studentNo}}"
        bindinput="onStudentNoInput"
      />
    </view>

    <view class="field">
      <text class="field__label">昵称</text>
      <input
        class="field__input"
        maxlength="20"
        placeholder="2–20 字，默认校园用户"
        value="{{nickname}}"
        bindinput="onNicknameInput"
      />
    </view>

    <view wx:if="{{error}}" class="login-error">{{error}}</view>

    <button
      class="btn btn--primary btn--block login-submit"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="onBind"
    >
      绑定并进入
    </button>

    <view class="login-note">
      一个微信只能绑定一个学号；一个学号只能绑定一个账号。学号仅保存加盐哈希，不保存明文。
    </view>
  </view>
</view>
