.answer-timer {
  display: flex;
  align-items: center;
  margin: 0;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #eef4ff;
}

.answer-timer__dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #2f6fed;
  animation: timer-pulse 1.4s ease-in-out infinite;
}

.answer-timer__text {
  font-size: 24rpx;
  color: #2f6fed;
}

@keyframes timer-pulse {
  0% {
    opacity: 0.35;
    transform: scale(0.85);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
  100% {
    opacity: 0.35;
    transform: scale(0.85);
  }
}
